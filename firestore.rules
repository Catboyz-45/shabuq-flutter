rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Super Admins are granted by creating superAdmins/{uid} in the Firebase
    // Console. Clients can never write that collection, so an email address
    // alone can no longer grant admin access.
    function isSuperAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    function isAdmin() {
      return isSuperAdmin() ||
        (
          signedIn() &&
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        );
    }

    function adminShopId() {
      return get(
        /databases/$(database)/documents/admins/$(request.auth.uid)
      ).data.shopId;
    }

    // An active shop admin (not the Super Admin, who runs no counter).
    function isShopStaff() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isShopAdminFor(shopId) {
      return isSuperAdmin() ||
        (isAdmin() && adminShopId() == shopId);
    }

    // An https link pasted by an admin, a bundled app image, or empty.
    // Mirrors isAllowedImageSource in lib/utils/image_source.dart.
    function validImage(value) {
      return value is string &&
        value.size() <= 500 &&
        (
          value == '' ||
          value.matches('^https://[^/]+[.][^/]+(/.*)?$') ||
          (
            value.matches('^assets/images/.+') &&
            !value.matches('.*[.][.].*')
          )
        );
    }

    function validShop(shopId, shopName) {
      return exists(/databases/$(database)/documents/shops/$(shopId)) &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.active == true &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.name == shopName;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create, update, delete: if isOwner(userId);

      match /coupons/{couponId} {
        allow read: if isOwner(userId);
        // The customer may discard their own coupon; shop staff remove it
        // when they redeem it at the counter (see couponRedemptions).
        allow delete: if isOwner(userId) ||
          (
            isShopStaff() &&
            resource.data.get('redemptionCode', '') != '' &&
            getAfter(
              /databases/$(database)/documents/couponRedemptions/$(resource.data.redemptionCode)
            ).data.status == 'redeemed' &&
            getAfter(
              /databases/$(database)/documents/couponRedemptions/$(resource.data.redemptionCode)
            ).data.userId == userId &&
            getAfter(
              /databases/$(database)/documents/couponRedemptions/$(resource.data.redemptionCode)
            ).data.couponCode == couponId
          );
        allow create: if isOwner(userId) &&
          couponId == request.resource.data.code &&
          request.resource.data.keys().hasOnly(['code', 'name', 'value']) &&
          exists(
            /databases/$(database)/documents/promoCodes/$(couponId)
          ) &&
          get(
            /databases/$(database)/documents/promoCodes/$(couponId)
          ).data.active == true &&
          request.resource.data.name ==
            get(
              /databases/$(database)/documents/promoCodes/$(couponId)
            ).data.name &&
          request.resource.data.value ==
            get(
              /databases/$(database)/documents/promoCodes/$(couponId)
            ).data.value &&
          existsAfter(
            /databases/$(database)/documents/users/$(userId)/used_codes/$(couponId)
          );
        // Showing a coupon at the counter links it to a fresh redemption code.
        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['redemptionCode']) &&
          getAfter(
            /databases/$(database)/documents/couponRedemptions/$(request.resource.data.redemptionCode)
          ).data.userId == userId;
      }

      match /used_codes/{code} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          exists(/databases/$(database)/documents/promoCodes/$(code)) &&
          get(
            /databases/$(database)/documents/promoCodes/$(code)
          ).data.active == true &&
          request.resource.data.keys().hasOnly(['used', 'createdAt']) &&
          request.resource.data.used == 1 &&
          request.resource.data.createdAt == request.time &&
          existsAfter(
            /databases/$(database)/documents/users/$(userId)/coupons/$(code)
          );
        allow update, delete: if false;
      }
    }

    match /promoCodes/{code} {
      allow read: if signedIn();
      allow create: if isSuperAdmin() &&
        code.matches('^[a-z0-9][a-z0-9_-]{2,29}$') &&
        request.resource.data.keys().hasOnly([
          'code',
          'name',
          'value',
          'active',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.code == code &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.value is int &&
        request.resource.data.value >= 1 &&
        request.resource.data.value <= 100000 &&
        request.resource.data.active == true &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isSuperAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'value', 'active', 'updatedAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.value is int &&
        request.resource.data.value >= 1 &&
        request.resource.data.value <= 100000 &&
        request.resource.data.active is bool &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isSuperAdmin();
    }

    match /superAdmins/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    match /admins/{adminId} {
      allow get: if isAdmin() || (signedIn() && adminId == request.auth.uid);
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
        adminId != request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'active',
          'shopId',
          'shopName',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.uid == adminId &&
        request.resource.data.email is string &&
        !exists(/databases/$(database)/documents/superAdmins/$(adminId)) &&
        request.resource.data.email ==
          get(/databases/$(database)/documents/users/$(adminId)).data.email &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() <= 80 &&
        request.resource.data.active == true &&
        validShop(
          request.resource.data.shopId,
          request.resource.data.shopName
        ) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isSuperAdmin() &&
        adminId != request.auth.uid &&
        !exists(/databases/$(database)/documents/superAdmins/$(adminId)) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'displayName',
            'active',
            'shopId',
            'shopName',
            'updatedAt'
          ]) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() <= 80 &&
        request.resource.data.active is bool &&
        validShop(
          request.resource.data.shopId,
          request.resource.data.shopName
        ) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isSuperAdmin() &&
        adminId != request.auth.uid &&
        !exists(/databases/$(database)/documents/superAdmins/$(adminId));
    }

    // Fields a shop's own admin may change: price, opening hours, contact
    // details and image, pausing bookings and the call pace for estimates.
    function validShopAdminSettings() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;
      return changed.hasOnly([
          'pricePerPerson',
          'openingHours',
          'image',
          'location',
          'phone',
          'acceptingQueues',
          'minutesPerQueue',
          'lastCalledAt',
          'updatedAt'
        ]) &&
        validImage(data.get('image', '')) &&
        data.get('location', '') is string &&
        data.get('location', '').size() <= 300 &&
        data.get('phone', '') is string &&
        data.get('phone', '').size() <= 30 &&
        data.get('openingHours', '') is string &&
        data.get('openingHours', '').size() <= 40 &&
        data.get('acceptingQueues', true) is bool &&
        data.get('minutesPerQueue', 0) is number &&
        data.get('minutesPerQueue', 0) >= 0 &&
        data.get('minutesPerQueue', 0) <= 120 &&
        (!('lastCalledAt' in changed) || data.lastCalledAt == request.time);
    }

    match /shops/{shopId} {
      allow read: if signedIn();
      allow create: if isSuperAdmin() &&
        shopId.matches('^[a-z0-9][a-z0-9-]{2,49}$') &&
        request.resource.data.keys().hasOnly([
          'name',
          'location',
          'phone',
          'image',
          'zones',
          'pricePerPerson',
          'openingHours',
          'active',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.get('openingHours', '') is string &&
        request.resource.data.get('openingHours', '').size() <= 40 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.location is string &&
        request.resource.data.location.size() <= 300 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 30 &&
        validImage(request.resource.data.image) &&
        request.resource.data.zones is list &&
        request.resource.data.zones.size() > 0 &&
        request.resource.data.zones.size() <= 20 &&
        request.resource.data.pricePerPerson is int &&
        request.resource.data.pricePerPerson >= 1 &&
        request.resource.data.pricePerPerson <= 100000 &&
        request.resource.data.active == true &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if (
        (
          isShopAdminFor(shopId) &&
          !isSuperAdmin() &&
          validShopAdminSettings()
        ) ||
        (
          isSuperAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'location',
            'phone',
            'image',
            'zones',
            'pricePerPerson',
            'openingHours',
            'active',
            'updatedAt'
          ]) &&
          request.resource.data.get('openingHours', '') is string &&
          request.resource.data.get('openingHours', '').size() <= 40 &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 120 &&
          request.resource.data.location is string &&
          request.resource.data.location.size() <= 300 &&
          request.resource.data.phone is string &&
          request.resource.data.phone.size() <= 30 &&
          validImage(request.resource.data.image) &&
          request.resource.data.zones is list &&
          request.resource.data.zones.size() > 0 &&
          request.resource.data.zones.size() <= 20 &&
          request.resource.data.active is bool
        )
      ) &&
        request.resource.data.pricePerPerson is int &&
        request.resource.data.pricePerPerson >= 1 &&
        request.resource.data.pricePerPerson <= 100000 &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Optional menu fields; items created before they existed have none.
    function validMenuDetails(data) {
      return data.get('description', '') is string &&
        data.get('description', '').size() <= 200 &&
        validImage(data.get('imageUrl', '')) &&
        data.get('price', 0) is int &&
        data.get('price', 0) >= 0 &&
        data.get('price', 0) <= 100000;
    }

    match /shops/{shopId}/menuItems/{menuItemId} {
      allow read: if signedIn();
      allow create: if isShopAdminFor(shopId) &&
        request.resource.data.keys().hasOnly([
          'shopId',
          'shopName',
          'name',
          'category',
          'active',
          'description',
          'imageUrl',
          'price',
          'createdAt',
          'updatedAt'
        ]) &&
        validMenuDetails(request.resource.data) &&
        request.resource.data.shopId == shopId &&
        validShop(shopId, request.resource.data.shopName) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.category.size() <= 80 &&
        request.resource.data.active is bool &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isShopAdminFor(shopId) &&
        resource.data.shopId == shopId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'category',
          'active',
          'description',
          'imageUrl',
          'price',
          'updatedAt'
        ]) &&
        validMenuDetails(request.resource.data) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.category.size() <= 80 &&
        request.resource.data.active is bool &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isShopAdminFor(shopId) &&
        resource.data.shopId == shopId;
    }

    // Today's business day in Bangkok (UTC+7, no daylight saving) from the
    // server clock, formatted like queueDateKey() in queue_position.dart.
    function bangkokDate() {
      let t = request.time + duration.value(7, 'h');
      return string(t.year()) + '-' +
        (t.month() < 10 ? '0' : '') + string(t.month()) + '-' +
        (t.day() < 10 ? '0' : '') + string(t.day());
    }

    function queueAt(queueId) {
      return /databases/$(database)/documents/queues/$(queueId);
    }

    function ticketAt(ticketId) {
      return /databases/$(database)/documents/queueTickets/$(ticketId);
    }

    // Numbers restart daily per shop and zone. Whoever issues a queue bumps
    // the counter by exactly one in the same transaction.
    match /shops/{shopId}/queueCounters/{zoneCode} {
      allow read: if signedIn();
      allow create, update: if signedIn() &&
        zoneCode.matches('^[A-Z]$') &&
        request.resource.data.keys().hasOnly(['date', 'last']) &&
        request.resource.data.date == bangkokDate() &&
        request.resource.data.last == (
          (resource == null || resource.data.date != request.resource.data.date)
            ? 1
            : resource.data.last + 1
        ) &&
        (
          isShopAdminFor(shopId) ||
          (
            existsAfter(queueAt(request.auth.uid)) &&
            getAfter(queueAt(request.auth.uid)).data.shopId == shopId &&
            getAfter(queueAt(request.auth.uid)).data.zoneCode == zoneCode &&
            getAfter(queueAt(request.auth.uid)).data.queueNumber ==
              request.resource.data.last
          )
        );
      allow delete: if false;
    }

    function validNewQueue(data) {
      return data.keys().hasOnly([
          'userId',
          'shopId',
          'shopName',
          'zone',
          'zoneCode',
          'partySize',
          'ticketId',
          'queueNumber',
          'queueLabel',
          'queueDate',
          'walkIn',
          'customerName',
          'status',
          'createdAt'
        ]) &&
        data.queueDate == bangkokDate() &&
        validShop(data.shopId, data.shopName) &&
        get(/databases/$(database)/documents/shops/$(data.shopId)).data
          .get('acceptingQueues', true) == true &&
        data.zone is string &&
        data.zone.size() > 0 &&
        data.zone.size() <= 80 &&
        data.zoneCode is string &&
        data.zoneCode.matches('^[A-Z]$') &&
        data.partySize is int &&
        data.partySize >= 1 &&
        data.partySize <= 10 &&
        data.ticketId is string &&
        data.ticketId.size() > 0 &&
        data.queueNumber is int &&
        data.queueNumber >= 1 &&
        data.queueLabel is string &&
        data.queueLabel.size() <= 8 &&
        data.customerName is string &&
        data.customerName.size() <= 60 &&
        data.status == 'waiting' &&
        data.createdAt == request.time &&
        getAfter(
          /databases/$(database)/documents/shops/$(data.shopId)/queueCounters/$(data.zoneCode)
        ).data.last == data.queueNumber &&
        existsAfter(ticketAt(data.ticketId));
    }

    match /queues/{queueId} {
      // Customer queues use the customer's uid as id; walk-ins added by staff
      // use walkin-{ticketId}. Only the customer and the shop's admins may
      // read them. Positions are calculated from queueTickets.
      allow read: if isOwner(queueId) || isShopAdminFor(resource.data.shopId);
      allow create: if validNewQueue(request.resource.data) &&
        (
          (
            isOwner(queueId) &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.walkIn == false
          ) ||
          (
            isShopAdminFor(request.resource.data.shopId) &&
            queueId == 'walkin-' + request.resource.data.ticketId &&
            request.resource.data.userId == '' &&
            request.resource.data.walkIn == true
          )
        );
      allow update: if isShopAdminFor(resource.data.shopId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'calledAt']) &&
        request.resource.data.status in ['waiting', 'called', 'serving'] &&
        request.resource.data.get('calledAt', request.time) is timestamp;
      allow delete: if
        isOwner(queueId) ||
        (
          isShopAdminFor(resource.data.shopId) &&
          existsAfter(
            /databases/$(database)/documents/queueHistory/$(resource.data.ticketId)
          ) &&
          getAfter(
            /databases/$(database)/documents/queueHistory/$(resource.data.ticketId)
          ).data.queueId == queueId
        );
    }

    // Anonymous public mirror of each active queue (id = ticketId). It holds
    // no user data, so any signed-in user may read it to count queues ahead.
    match /queueTickets/{ticketId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'shopId',
          'zone',
          'queueLabel',
          'queueDate',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.queueDate == bangkokDate() &&
        request.resource.data.status == 'waiting' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.queueLabel is string &&
        request.resource.data.queueLabel.size() <= 8 &&
        (
          (
            existsAfter(queueAt(request.auth.uid)) &&
            getAfter(queueAt(request.auth.uid)).data.ticketId == ticketId &&
            getAfter(queueAt(request.auth.uid)).data.shopId ==
              request.resource.data.shopId &&
            getAfter(queueAt(request.auth.uid)).data.zone ==
              request.resource.data.zone &&
            getAfter(queueAt(request.auth.uid)).data.queueDate ==
              request.resource.data.queueDate
          ) ||
          (
            isShopAdminFor(request.resource.data.shopId) &&
            existsAfter(queueAt('walkin-' + ticketId))
          )
        );
      allow update: if isShopAdminFor(resource.data.shopId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']) &&
        request.resource.data.status in ['waiting', 'called', 'serving'];
      allow delete: if
        (
          signedIn() &&
          exists(queueAt(request.auth.uid)) &&
          get(queueAt(request.auth.uid)).data.ticketId == ticketId &&
          !existsAfter(queueAt(request.auth.uid))
        ) ||
        isShopAdminFor(resource.data.shopId);
    }

    // Closed queues (id = ticketId), kept for the customer's history and the
    // shop's statistics.
    match /queueHistory/{historyId} {
      allow read: if
        (signedIn() && resource.data.userId == request.auth.uid) ||
        isShopAdminFor(resource.data.shopId);
      allow create: if
        isShopAdminFor(request.resource.data.shopId) &&
        request.resource.data.keys().hasOnly([
          'userId',
          'shopId',
          'shopName',
          'zone',
          'zoneCode',
          'partySize',
          'ticketId',
          'queueNumber',
          'queueLabel',
          'queueDate',
          'walkIn',
          'customerName',
          'status',
          'createdAt',
          'calledAt',
          'queueId',
          'completedAt',
          'completedBy'
        ]) &&
        historyId == request.resource.data.ticketId &&
        request.resource.data.status in ['completed', 'no_show', 'cancelled'] &&
        request.resource.data.completedAt == request.time &&
        request.resource.data.completedBy == request.auth.uid &&
        exists(queueAt(request.resource.data.queueId)) &&
        get(queueAt(request.resource.data.queueId)).data.ticketId == historyId &&
        get(queueAt(request.resource.data.queueId)).data.shopId ==
          request.resource.data.shopId &&
        !existsAfter(queueAt(request.resource.data.queueId));
      allow update, delete: if false;
    }

    // A customer shows a 6-character code at the counter; shop staff type it
    // in to redeem the coupon. Codes expire after 10 minutes and can only be
    // fetched by id, so they cannot be listed or guessed in bulk.
    match /couponRedemptions/{code} {
      allow get: if signedIn() &&
        (resource == null || resource.data.userId == request.auth.uid || isShopStaff());
      allow list, delete: if false;
      allow create: if signedIn() &&
        code.matches('^[A-HJ-NP-Z2-9]{6}$') &&
        request.resource.data.keys().hasOnly([
          'userId',
          'couponCode',
          'couponName',
          'value',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.couponName ==
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)/coupons/$(request.resource.data.couponCode)
          ).data.name &&
        request.resource.data.value ==
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)/coupons/$(request.resource.data.couponCode)
          ).data.value &&
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/coupons/$(request.resource.data.couponCode)
        ).data.redemptionCode == code;
      allow update: if isShopStaff() &&
        resource.data.status == 'pending' &&
        request.time < resource.data.createdAt + duration.value(10, 'm') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'redeemedAt',
          'redeemedBy',
          'shopId'
        ]) &&
        request.resource.data.status == 'redeemed' &&
        request.resource.data.redeemedAt == request.time &&
        request.resource.data.redeemedBy == request.auth.uid &&
        request.resource.data.shopId == adminShopId() &&
        !existsAfter(
          /databases/$(database)/documents/users/$(resource.data.userId)/coupons/$(resource.data.couponCode)
        );
    }

    // Home screen banners, managed by Super Admins.
    match /banners/{bannerId} {
      allow read: if signedIn();
      allow create, update: if isSuperAdmin() &&
        request.resource.data.keys().hasOnly([
          'imageUrl',
          'title',
          'shopId',
          'order',
          'active',
          'createdAt',
          'updatedAt'
        ]) &&
        validImage(request.resource.data.imageUrl) &&
        request.resource.data.imageUrl != '' &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 80 &&
        request.resource.data.shopId is string &&
        (
          request.resource.data.shopId == '' ||
          exists(/databases/$(database)/documents/shops/$(request.resource.data.shopId))
        ) &&
        request.resource.data.order is int &&
        request.resource.data.active is bool &&
        request.resource.data.updatedAt == request.time &&
        (
          resource != null ||
          request.resource.data.createdAt == request.time
        );
      allow delete: if isSuperAdmin();
    }

    // Help, terms and privacy pages, edited by Super Admins.
    match /appContent/{pageId} {
      allow read: if true;
      allow write: if isSuperAdmin() &&
        pageId in ['help', 'terms', 'privacy'] &&
        request.resource.data.keys().hasOnly(['body', 'updatedAt']) &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 10000 &&
        request.resource.data.updatedAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
