rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Super Admins are granted by creating superAdmins/{uid} in the Firebase
    // Console. Clients can never write that collection, so an email address
    // alone can no longer grant admin access.
    function isSuperAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    function isAdmin() {
      return isSuperAdmin() ||
        (
          signedIn() &&
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        );
    }

    function adminShopId() {
      return get(
        /databases/$(database)/documents/admins/$(request.auth.uid)
      ).data.shopId;
    }

    function isShopAdminFor(shopId) {
      return isSuperAdmin() ||
        (isAdmin() && adminShopId() == shopId);
    }

    function validShop(shopId, shopName) {
      return exists(/databases/$(database)/documents/shops/$(shopId)) &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.active == true &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.name == shopName;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create, update, delete: if isOwner(userId);

      match /coupons/{couponId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) &&
          couponId == request.resource.data.code &&
          request.resource.data.keys().hasOnly(['code', 'name', 'value']) &&
          exists(
            /databases/$(database)/documents/promoCodes/$(couponId)
          ) &&
          get(
            /databases/$(database)/documents/promoCodes/$(couponId)
          ).data.active == true &&
          request.resource.data.name ==
            get(
              /databases/$(database)/documents/promoCodes/$(couponId)
            ).data.name &&
          request.resource.data.value ==
            get(
              /databases/$(database)/documents/promoCodes/$(couponId)
            ).data.value &&
          existsAfter(
            /databases/$(database)/documents/users/$(userId)/used_codes/$(couponId)
          );
        allow update: if false;
      }

      match /used_codes/{code} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          exists(/databases/$(database)/documents/promoCodes/$(code)) &&
          get(
            /databases/$(database)/documents/promoCodes/$(code)
          ).data.active == true &&
          request.resource.data.keys().hasOnly(['used', 'createdAt']) &&
          request.resource.data.used == 1 &&
          request.resource.data.createdAt == request.time &&
          existsAfter(
            /databases/$(database)/documents/users/$(userId)/coupons/$(code)
          );
        allow update, delete: if false;
      }
    }

    match /promoCodes/{code} {
      allow read: if signedIn();
      allow create: if isSuperAdmin() &&
        code.matches('^[a-z0-9][a-z0-9_-]{2,29}$') &&
        request.resource.data.keys().hasOnly([
          'code',
          'name',
          'value',
          'active',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.code == code &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.value is int &&
        request.resource.data.value >= 1 &&
        request.resource.data.value <= 100000 &&
        request.resource.data.active == true &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isSuperAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'value', 'active', 'updatedAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.value is int &&
        request.resource.data.value >= 1 &&
        request.resource.data.value <= 100000 &&
        request.resource.data.active is bool &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isSuperAdmin();
    }

    match /superAdmins/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    match /admins/{adminId} {
      allow get: if isAdmin() || (signedIn() && adminId == request.auth.uid);
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
        adminId != request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'active',
          'shopId',
          'shopName',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.uid == adminId &&
        request.resource.data.email is string &&
        !exists(/databases/$(database)/documents/superAdmins/$(adminId)) &&
        request.resource.data.email ==
          get(/databases/$(database)/documents/users/$(adminId)).data.email &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() <= 80 &&
        request.resource.data.active == true &&
        validShop(
          request.resource.data.shopId,
          request.resource.data.shopName
        ) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isSuperAdmin() &&
        adminId != request.auth.uid &&
        !exists(/databases/$(database)/documents/superAdmins/$(adminId)) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'displayName',
            'active',
            'shopId',
            'shopName',
            'updatedAt'
          ]) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() <= 80 &&
        request.resource.data.active is bool &&
        validShop(
          request.resource.data.shopId,
          request.resource.data.shopName
        ) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isSuperAdmin() &&
        adminId != request.auth.uid &&
        !exists(/databases/$(database)/documents/superAdmins/$(adminId));
    }

    match /shops/{shopId} {
      allow read: if signedIn();
      allow create: if isSuperAdmin() &&
        shopId.matches('^[a-z0-9][a-z0-9-]{2,49}$') &&
        request.resource.data.keys().hasOnly([
          'name',
          'location',
          'phone',
          'image',
          'zones',
          'pricePerPerson',
          'active',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.location is string &&
        request.resource.data.location.size() <= 300 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 30 &&
        request.resource.data.image is string &&
        (
          request.resource.data.image == '' ||
          request.resource.data.image.matches('^https://.*')
        ) &&
        request.resource.data.image.size() <= 500 &&
        request.resource.data.zones is list &&
        request.resource.data.zones.size() > 0 &&
        request.resource.data.zones.size() <= 20 &&
        request.resource.data.pricePerPerson is int &&
        request.resource.data.pricePerPerson >= 1 &&
        request.resource.data.pricePerPerson <= 100000 &&
        request.resource.data.active == true &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if (
        (
          isShopAdminFor(shopId) &&
          !isSuperAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['pricePerPerson', 'updatedAt'])
        ) ||
        (
          isSuperAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'location',
            'phone',
            'image',
            'zones',
            'pricePerPerson',
            'active',
            'updatedAt'
          ]) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 120 &&
          request.resource.data.location is string &&
          request.resource.data.location.size() <= 300 &&
          request.resource.data.phone is string &&
          request.resource.data.phone.size() <= 30 &&
          request.resource.data.image is string &&
          (
            request.resource.data.image == '' ||
            request.resource.data.image.matches('^https://.*') ||
            request.resource.data.image.matches('^assets/images/.*')
          ) &&
          request.resource.data.image.size() <= 500 &&
          request.resource.data.zones is list &&
          request.resource.data.zones.size() > 0 &&
          request.resource.data.zones.size() <= 20 &&
          request.resource.data.active is bool
        )
      ) &&
        request.resource.data.pricePerPerson is int &&
        request.resource.data.pricePerPerson >= 1 &&
        request.resource.data.pricePerPerson <= 100000 &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /shops/{shopId}/menuItems/{menuItemId} {
      allow read: if signedIn();
      allow create: if isShopAdminFor(shopId) &&
        request.resource.data.keys().hasOnly([
          'shopId',
          'shopName',
          'name',
          'category',
          'active',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.shopId == shopId &&
        validShop(shopId, request.resource.data.shopName) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.category.size() <= 80 &&
        request.resource.data.active is bool &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isShopAdminFor(shopId) &&
        resource.data.shopId == shopId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'category',
          'active',
          'updatedAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.category.size() <= 80 &&
        request.resource.data.active is bool &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isShopAdminFor(shopId) &&
        resource.data.shopId == shopId;
    }

    match /queues/{queueId} {
      // Queue documents name the customer, so only the customer and the shop's
      // admins may read them. Positions are calculated from queueTickets.
      allow read: if isOwner(queueId) || isShopAdminFor(resource.data.shopId);
      allow create: if isOwner(queueId) &&
        request.resource.data.keys().hasOnly([
          'userId',
          'shopId',
          'shopName',
          'zone',
          'partySize',
          'payMethod',
          'paymentId',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        validShop(
          request.resource.data.shopId,
          request.resource.data.shopName
        ) &&
        request.resource.data.shopName is string &&
        request.resource.data.shopName.size() > 0 &&
        request.resource.data.shopName.size() <= 120 &&
        request.resource.data.zone is string &&
        request.resource.data.zone.size() > 0 &&
        request.resource.data.zone.size() <= 80 &&
        request.resource.data.partySize is int &&
        request.resource.data.partySize >= 1 &&
        request.resource.data.partySize <= 10 &&
        request.resource.data.payMethod in ['counter', 'qr'] &&
        request.resource.data.paymentId is string &&
        request.resource.data.status == 'waiting' &&
        request.resource.data.createdAt == request.time &&
        existsAfter(
          /databases/$(database)/documents/payments/$(request.resource.data.paymentId)
        ) &&
        getAfter(
          /databases/$(database)/documents/payments/$(request.resource.data.paymentId)
        ).data.userId == request.auth.uid &&
        existsAfter(
          /databases/$(database)/documents/queueTickets/$(request.resource.data.paymentId)
        );
      allow update: if isShopAdminFor(resource.data.shopId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']) &&
        request.resource.data.status in [
          'waiting',
          'serving',
          'cancelled'
        ];
      allow delete: if
        (
          signedIn() &&
          resource.data.userId == request.auth.uid &&
          queueId == request.auth.uid
        ) ||
        (
          isShopAdminFor(resource.data.shopId) &&
          existsAfter(
            /databases/$(database)/documents/queueHistory/$(resource.data.paymentId)
          ) &&
          getAfter(
            /databases/$(database)/documents/queueHistory/$(resource.data.paymentId)
          ).data.userId == resource.data.userId &&
          getAfter(
            /databases/$(database)/documents/queueHistory/$(resource.data.paymentId)
          ).data.shopId == resource.data.shopId &&
          getAfter(
            /databases/$(database)/documents/queueHistory/$(resource.data.paymentId)
          ).data.status == 'completed'
        );
    }

    // Anonymous public mirror of each active queue (id = paymentId). It holds
    // no user data, so any signed-in user may read it to count queues ahead.
    match /queueTickets/{ticketId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'shopId',
          'zone',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.status == 'waiting' &&
        request.resource.data.createdAt == request.time &&
        existsAfter(
          /databases/$(database)/documents/queues/$(request.auth.uid)
        ) &&
        getAfter(
          /databases/$(database)/documents/queues/$(request.auth.uid)
        ).data.paymentId == ticketId &&
        getAfter(
          /databases/$(database)/documents/queues/$(request.auth.uid)
        ).data.shopId == request.resource.data.shopId &&
        getAfter(
          /databases/$(database)/documents/queues/$(request.auth.uid)
        ).data.zone == request.resource.data.zone;
      allow update: if isShopAdminFor(resource.data.shopId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']) &&
        request.resource.data.status in [
          'waiting',
          'serving',
          'cancelled'
        ];
      allow delete: if
        (
          signedIn() &&
          get(
            /databases/$(database)/documents/payments/$(ticketId)
          ).data.userId == request.auth.uid &&
          !existsAfter(
            /databases/$(database)/documents/queues/$(request.auth.uid)
          )
        ) ||
        isShopAdminFor(resource.data.shopId);
    }

    match /queueHistory/{historyId} {
      allow read: if
        (signedIn() && resource.data.userId == request.auth.uid) ||
        isShopAdminFor(resource.data.shopId);
      allow create: if
        isShopAdminFor(request.resource.data.shopId) &&
        request.resource.data.keys().hasOnly([
          'userId',
          'shopId',
          'shopName',
          'zone',
          'partySize',
          'payMethod',
          'paymentId',
          'status',
          'createdAt',
          'completedAt',
          'completedBy'
        ]) &&
        historyId == request.resource.data.paymentId &&
        request.resource.data.status == 'completed' &&
        request.resource.data.completedAt == request.time &&
        request.resource.data.completedBy == request.auth.uid &&
        validShop(
          request.resource.data.shopId,
          request.resource.data.shopName
        ) &&
        exists(
          /databases/$(database)/documents/queues/$(request.resource.data.userId)
        ) &&
        get(
          /databases/$(database)/documents/queues/$(request.resource.data.userId)
        ).data.paymentId == historyId &&
        get(
          /databases/$(database)/documents/queues/$(request.resource.data.userId)
        ).data.shopId == request.resource.data.shopId &&
        !existsAfter(
          /databases/$(database)/documents/queues/$(request.resource.data.userId)
        );
      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if
        (signedIn() && resource.data.userId == request.auth.uid) ||
        isShopAdminFor(resource.data.shopId);
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'paymentId',
          'userId',
          'shopId',
          'shopName',
          'partySize',
          'pricePerPerson',
          'total',
          'coupon',
          'discount',
          'netTotal',
          'payMethod',
          'couponCode',
          'createdAt'
        ]) &&
        request.resource.data.paymentId == paymentId &&
        request.resource.data.userId == request.auth.uid &&
        validShop(
          request.resource.data.shopId,
          request.resource.data.shopName
        ) &&
        request.resource.data.shopName is string &&
        request.resource.data.shopName.size() > 0 &&
        request.resource.data.shopName.size() <= 120 &&
        request.resource.data.partySize is int &&
        request.resource.data.partySize >= 1 &&
        request.resource.data.partySize <= 10 &&
        request.resource.data.pricePerPerson ==
          get(
            /databases/$(database)/documents/shops/$(request.resource.data.shopId)
          ).data.pricePerPerson &&
        request.resource.data.total ==
          request.resource.data.partySize * request.resource.data.pricePerPerson &&
        request.resource.data.discount is int &&
        request.resource.data.discount >= 0 &&
        request.resource.data.discount <= request.resource.data.total &&
        request.resource.data.couponCode is string &&
        (
          (
            request.resource.data.couponCode == '' &&
            request.resource.data.coupon == '' &&
            request.resource.data.discount == 0
          ) ||
          (
            request.resource.data.couponCode != '' &&
            exists(
              /databases/$(database)/documents/users/$(request.auth.uid)/coupons/$(request.resource.data.couponCode)
            ) &&
            !existsAfter(
              /databases/$(database)/documents/users/$(request.auth.uid)/coupons/$(request.resource.data.couponCode)
            ) &&
            request.resource.data.coupon ==
              get(
                /databases/$(database)/documents/users/$(request.auth.uid)/coupons/$(request.resource.data.couponCode)
              ).data.name &&
            (
              (
                request.resource.data.discount ==
                  get(
                    /databases/$(database)/documents/users/$(request.auth.uid)/coupons/$(request.resource.data.couponCode)
                  ).data.value &&
                get(
                  /databases/$(database)/documents/users/$(request.auth.uid)/coupons/$(request.resource.data.couponCode)
                ).data.value <= request.resource.data.total
              ) ||
              (
                request.resource.data.discount == request.resource.data.total &&
                get(
                  /databases/$(database)/documents/users/$(request.auth.uid)/coupons/$(request.resource.data.couponCode)
                ).data.value >= request.resource.data.total
              )
            )
          )
        ) &&
        request.resource.data.netTotal ==
          request.resource.data.total - request.resource.data.discount &&
        request.resource.data.payMethod in ['counter', 'qr'] &&
        request.resource.data.createdAt == request.time &&
        existsAfter(
          /databases/$(database)/documents/queues/$(request.auth.uid)
        ) &&
        getAfter(
          /databases/$(database)/documents/queues/$(request.auth.uid)
        ).data.paymentId == paymentId &&
        getAfter(
          /databases/$(database)/documents/queues/$(request.auth.uid)
        ).data.shopId == request.resource.data.shopId;
      allow update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() &&
        resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
